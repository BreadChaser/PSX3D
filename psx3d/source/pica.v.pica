; Vertex shader for gpu_pica (the core's PS1 renderer on the 3DS GPU).
; Positions arrive in PS1 VRAM pixels, texture coordinates in texels of a
; texture (the uniform texscale is 1 / its size), colours as 0-255 bytes.
.fvec proj[4]

.constf consts(0.5, 1.0, 0.00392156862745, 0.0)
.constf dither_scale(0.0078125, 0.0078125, 0.0, 0.0)
.constf uv_bias(0.015625, 0.015625, 0.0, 0.0)
.fvec texscale

.out outpos position
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outclr color

.alias inpos v0
.alias intex v1
.alias inclr v2

.proc main
	mov r0.xy, inpos.xy
	mov r0.z, consts.w
	mov r0.w, consts.y
	dp4 outpos.x, proj[0], r0
	dp4 outpos.y, proj[1], r0
	dp4 outpos.z, proj[2], r0
	dp4 outpos.w, proj[3], r0
	; (u + 1/64) / size. Polygons are sampled where the PS1 samples, so
	; 1:1 mapped ones sample exactly on texel edges; the GPU's interpolated
	; coordinate lands a hair below there and took the texel to the left
	; or above, outside the polygon: seams and black dots along mesh edges.
	; 1/64 texel lifts those samples into their own texel. Rectangles
	; sample texel centres, unaffected.
	add r1.xy, uv_bias.xy, intex.xy
	mul r1.xy, texscale.xy, r1.xy
	mov r1.zw, consts.ww
	mov outtc0, r1
	; Sixteenth-pixel position / 128 maps one VRAM pixel to one 8x8 texel.
	; Its repeated 4x4 pattern remains anchored to VRAM across drawing areas.
	mul outtc1, dither_scale, r0
	mul outclr, consts.zzzz, inclr
	end
.end
