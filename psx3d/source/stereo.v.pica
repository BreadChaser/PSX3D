; Stereo warp mesh: transform position, pass the texture coordinate through.
.fvec projection[4]

.out outpos position
.out outtc0 texcoord0

.alias inpos v0
.alias intex v1

.proc main
	dp4 outpos.x, projection[0], inpos
	dp4 outpos.y, projection[1], inpos
	dp4 outpos.z, projection[2], inpos
	dp4 outpos.w, projection[3], inpos
	mov outtc0, intex
	end
.end
