+	if (!dump && getenv("SIMDUMP")) dump = fopen(getenv("SIMDUMP"), "w");
+	if (dump) fprintf(dump, "%08x %08x %08x %08x %08x %08x %08x  %d %d\n", rec[0], rec[1], rec[2], rec[3], rec[4], rec[5], rec[6], v->u, v->v);
+}
