+
+static void psx3d_ov_clear_rows(u16 *b, const u32 *rows)
+{
+  u32 v = PSX3D_OV_KEY | (PSX3D_OV_KEY << 16);
+  for (int y = 0; y < 512; y++) {
+    if (!(rows[y >> 5] & (1u << (y & 31))))
+      continue;
+    u32 *p = (u32 *)(b + y * 1024);
+    for (int i = 0; i < 512; i++)
+      p[i] = v;
+  }
+}
+
+static void psx3d_ov_clear(u16 *b)
+{
+  u32 all[16];
+  memset(all, 0xff, sizeof(all));
+  psx3d_ov_clear_rows(b, all);
