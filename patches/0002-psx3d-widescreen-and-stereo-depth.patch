+static u16 psx3d_cur[PSX3D_DM_H][PSX3D_DM_W];
+static psx3d_depthmap psx3d_pub;
+static u32 psx3d_prims;      // primitives recorded since the last publish
+static u32 psx3d_rank;       // 3D polygons drawn so far this frame
