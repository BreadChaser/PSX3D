+static bool psx3d_ov_alloc(void)
+{
+  for (int i = 0; i < 2; i++) {
+    if (!psx3d_ov_buf[i] && !(psx3d_ov_buf[i] = (u16 *)malloc(1024 * 512 * 2)))
+      return false;
+    psx3d_ov_clear(psx3d_ov_buf[i]);
+  }
+  return true;
