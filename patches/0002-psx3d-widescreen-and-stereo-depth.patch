+int psx3d_idle_skip = 1; // test switch: fast-forward polling loops
+
+// Polling loop: a short backward branch whose loop path only loads from RAM or
+// I_STAT/I_MASK and computes, with no register carried between iterations. With
+// no stores, memory only changes at events, which come only at cycle checks, so
+// every iteration before the next check fires is an exact repeat and can be
+// skipped by just adding its cycles.
+struct idle_loop {
+  int iter;           // cycles per iteration
+  int nchk;           // loads whose RAM address is checked at run time
+  u_char chk_reg[3];
+  short chk_ofs[3];
+};
+
+static int idle_loop_check(struct compile_state *st, int i, struct idle_loop *il)
+{
+  u_int ba = cinfo[i].ba;
+  int t = (ba - st->start) >> 2, j, k;
+  uint64_t wr = 0, wr_all = 0, cst = 1;
+  u_int cval[32];
+
+  if (!psx3d_idle_skip || !internal_branch(st, ba) || t > i || i - t > 24
+      || dops[t].is_ds || dops[i+1].is_jump)
+    return 0;
+  cval[0] = 0;
+  for (j = t; j <= i + 1; j++)
+    wr_all |= (1ull << dops[j].rt1) | (1ull << dops[j].rt2);
+  wr_all &= ~1ull;
+  il->iter = -cinfo[t].ccadj;
+  il->nchk = 0;
+  for (j = t; j <= i + 1; j++) {
+    const struct decoded_insn *d = &dops[j];
+    uint64_t rd = (1ull << d->rs1) | (1ull << d->rs2);
+    // sources written in the loop must be written earlier in this iteration
+    if ((rd & wr_all & ~wr) & ~1ull)
+      return 0;
+    switch (d->itype) {
+    case NOP:
+      break;
+    case ALU: case SHIFT: case SHIFTIMM:
+      cst &= ~(1ull << d->rt1);
+      break;
+    case IMM16:
+      if (d->opcode == 0x0f) // lui
+        cst |= 1ull << d->rt1, cval[d->rt1] = cinfo[j].imm << 16;
+      else if ((d->opcode == 0x09 || d->opcode == 0x0d) && ((cst >> d->rs1) & 1)) {
+        u_int v = cval[d->rs1];
+        v = d->opcode == 0x09 ? v + cinfo[j].imm : (v | (cinfo[j].imm & 0xffff));
+        cst |= 1ull << d->rt1, cval[d->rt1] = v;
+      }
+      else
+        cst &= ~(1ull << d->rt1);
+      break;
+    case LOAD:
+      if ((cst >> d->rs1) & 1) {
+        u_int a = cval[d->rs1] + cinfo[j].imm;
+        if (!is_ram_addr(a) && (a & 0x1ffffff8) != 0x1f801070)
+          return 0;
+      }
+      else if (!((wr_all >> d->rs1) & 1)) {
+        for (k = 0; k < il->nchk; k++)
+          if (il->chk_reg[k] == d->rs1 && il->chk_ofs[k] == cinfo[j].imm)
+            break;
+        if (k == il->nchk) {
+          if (k == ARRAY_SIZE(il->chk_reg))
+            return 0;
+          il->chk_reg[k] = d->rs1, il->chk_ofs[k] = cinfo[j].imm;
+          il->nchk++;
+        }
+      }
+      else
+        return 0;
+      cst &= ~(1ull << d->rt1);
+      break;
+    case CJUMP: case SJUMP:
+      if (j == i + 1 || d->rt1 == 31) // no branch in DS, no bltzal
+        return 0;
+      if (j < i && cinfo[j].ba >= ba && cinfo[j].ba <= st->start + (i + 1) * 4)
+        return 0; // exits only
+      il->iter += cinfo[j].ccadj + CLOCK_ADJUST(2);
+      break;
+    default:
+      return 0;
+    }
+    wr |= (1ull << d->rt1) | (1ull << d->rt2);
+  }
+#ifdef PSX3D_SIM
+  if (il->iter > 0)
+    SysPrintf("idle loop @%08x..%08x %d cycles, %d checks, ooo %d\n", ba, st->start + i*4, il->iter, il->nchk, dops[i].ooo);
+#endif
+  return il->iter > 0;
+}
+
+// emitted on the taken back-edge with cc = cycle count at the loop head
+static void idle_loop_assemble(int i, const struct idle_loop *il, int adj, int cc)
+{
+  // last_count when this code last ran: changed = an event came during this
+  // iteration, after its loads
+  void *lc_seen = (u_char *)dynarec_local + LO_unused2;
+  int tmp = get_reg_temp(branch_regs[i].regmap);
+  void *t_exit[4], *loop;
+  int j, n, step;
+  for (j = 0; j < il->nchk; j++)
+    if (get_reg(branch_regs[i].regmap, il->chk_reg[j]) < 0)
+      return;
+  if (tmp < 0)
+    return;
+  assem_debug("; idle skip, %d cycles\n", il->iter);
+  host_tempreg_acquire();
+  emit_readword(&last_count, tmp);
+  emit_readword(lc_seen, HOST_TEMPREG);
+  emit_writeword(tmp, lc_seen);
+  emit_cmp(tmp, HOST_TEMPREG);
+  t_exit[il->nchk] = out;
+  emit_jne(0);
+  for (j = 0; j < il->nchk; j++) {
+    emit_addimm(get_reg(branch_regs[i].regmap, il->chk_reg[j]), il->chk_ofs[j], tmp);
+    emit_andimm(tmp, 0x1fffffff, tmp);
+    emit_cmpimm(tmp, 0x800000);
+    t_exit[j] = out;
+    emit_jc(0);
+  }
+  // skip n iterations while the back-edge check after them would not fire
+  for (n = 64; n >= 1; n /= 8) {
+    step = n * il->iter;
+    if (step + adj >= 65536)
+      continue;
+    loop = out;
+    emit_cmpimm(cc, -(step + adj));
+    void *t_next = out;
+    emit_jge(0);
+    emit_addimm(cc, step, cc);
+    emit_jmp(loop);
+    set_jump_target(t_next, out);
+  }
+  for (j = 0; j <= il->nchk; j++)
+    set_jump_target(t_exit[j], out);
+  host_tempreg_release();
+}
+
+// PsyQ "while (VSync(1) < n);": VSync(1) reads the hblank counter (root counter 1)
+// and returns lines since the last vblank. Iterations between two counter ticks
+// and before the next event are identical (the stack is rewritten with the same
+// values), so whole iterations are skipped, measured from two equal ones.
