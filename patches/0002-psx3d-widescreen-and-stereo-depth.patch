+// 2D drawn after the 3D scene is an overlay (HUD); before it, a backdrop
+static inline u16 psx3d_flat_z(void)
+{
+  return psx3d_seen_3d ? PSX3D_Z_OVERLAY : PSX3D_Z_FAR;
+}
